# Copiá este archivo a .env.local para probar en tu computadora,
# y cargá las mismas variables en Vercel (Settings → Environment Variables).

# URL que te da Apps Script al implementar como "Aplicación web" (termina en /exec).
# SIN el prefijo VITE_ a propósito: así queda solo del lado del servidor, nunca
# visible en el código público del sitio.
APPS_SCRIPT_URL=

# El mismo valor que pusiste en la propiedad de script API_TOKEN en Apps Script.
# Este SÍ lleva VITE_ porque el navegador lo necesita para armar los pedidos
# (viaja hacia /api/sheets, no directo a Apps Script).
VITE_API_TOKEN=
